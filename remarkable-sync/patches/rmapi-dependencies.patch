diff --git a/api/token_hardening_test.go b/api/token_hardening_test.go
new file mode 100644
index 0000000..4178170
--- /dev/null
+++ b/api/token_hardening_test.go
@@ -0,0 +1,42 @@
+package api
+
+import (
+	"encoding/base64"
+	"fmt"
+	"runtime"
+	"strings"
+	"testing"
+	"time"
+)
+
+func tokenFixture(payload string) string {
+	return base64.RawURLEncoding.EncodeToString([]byte(`{"alg":"HS256","typ":"JWT"}`)) + "." + base64.RawURLEncoding.EncodeToString([]byte(payload)) + ".unused"
+}
+func TestParseTokenRejectsExcessSegmentsWithoutAmplifiedAllocation(t *testing.T) {
+	malicious := strings.Repeat(".", 1<<20)
+	runtime.GC()
+	var before, after runtime.MemStats
+	runtime.ReadMemStats(&before)
+	if _, err := ParseToken(malicious); err == nil {
+		t.Fatal("malformed token accepted")
+	}
+	runtime.ReadMemStats(&after)
+	if used := after.TotalAlloc - before.TotalAlloc; used > 4<<20 {
+		t.Fatalf("malformed token caused amplified allocation: %d bytes", used)
+	}
+}
+func TestParseTokenCompatibilityAndMissingExpiry(t *testing.T) {
+	for _, expiry := range []string{"", fmt.Sprintf(`,"exp":%d`, time.Now().Add(time.Hour).Unix())} {
+		token := tokenFixture(`{"auth0-profile":{"email":"fixture@example.invalid"},"scopes":"sync:fox"` + expiry + `}`)
+		parsed, err := ParseToken(token)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if parsed.User != "fixture@example.invalid" || parsed.SyncVersion != Version15 {
+			t.Fatal("valid metadata token changed")
+		}
+	}
+	if _, err := ParseToken(tokenFixture(`{"exp":1}`)); err == nil {
+		t.Fatal("expired token accepted")
+	}
+}
